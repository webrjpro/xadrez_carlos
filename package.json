{
  "name": "xadrez-a-f",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "WebRJPro",
  "description": "Grandmaster 3D Chess",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:start": "cross-env NODE_ENV=development concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wait-on": "^8.0.2"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "gsap": "^3.15.0",
    "peerjs": "^1.5.5",
    "three": "^0.185.1"
  },
  "build": {
    "appId": "com.webrjpro.xadrezcarlos",
    "productName": "Grandmaster 3D",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
